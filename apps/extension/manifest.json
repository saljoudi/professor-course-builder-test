{
  "manifest_version": 3,
  "name": "Professor Course Builder",
  "version": "0.1.0",
  "description": "Upload course materials, generate an interactive course, preview it, and publish it through your managed platform.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://localhost:8787/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Professor Course Builder" },
  "options_page": "options.html",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
