# ==========================================================
# PROFESSOR COURSE BUILDER - MOCK-FIRST CONFIGURATION
# Copy this file to .env. The defaults below run locally.
# ==========================================================

PORT=8787
PUBLIC_API_URL=http://localhost:8787
APP_NAME=Professor Course Builder

# ----------------------------------------------------------
# ADAPTER MODES
# Keep all of these as mock until your real accounts exist.
# ----------------------------------------------------------
AI_PROVIDER=mock
DATABASE_PROVIDER=mock
PAYMENT_PROVIDER=mock
GITHUB_PROVIDER=mock
RENDER_PROVIDER=mock
AUTH_PROVIDER=mock

# ----------------------------------------------------------
# OPENAI - replace only when AI_PROVIDER=openai
# NEVER put this key in the browser extension.
# ----------------------------------------------------------
OPENAI_API_KEY=MOCK_REPLACE_ME
OPENAI_MODEL=REPLACE_WITH_MODEL_AVAILABLE_TO_YOUR_ACCOUNT

# ----------------------------------------------------------
# GITHUB - replace only when GITHUB_PROVIDER=github
# Use one repository for platform code + all course JSON.
# Example repo URL: https://github.com/your-org/course-platform
# ----------------------------------------------------------
GITHUB_TOKEN=MOCK_REPLACE_ME
GITHUB_OWNER=your-org-or-user
GITHUB_REPO=your-repository-name
GITHUB_BRANCH=main
GITHUB_REPO_URL=https://github.com/your-org-or-user/your-repository-name

# ----------------------------------------------------------
# RENDER - replace only when RENDER_PROVIDER=render
# Workspace ID is shown in Render workspace settings.
# ----------------------------------------------------------
RENDER_API_KEY=MOCK_REPLACE_ME
RENDER_OWNER_ID=MOCK_WORKSPACE_ID
RENDER_BRANCH=main
RENDER_BUILD_COMMAND=npm install && npm run build:course
RENDER_PUBLISH_PATH=dist

# ----------------------------------------------------------
# CENTRAL DATABASE - future replacement for mock JSON store
# Example: postgres://...
# ----------------------------------------------------------
DATABASE_URL=MOCK_REPLACE_ME

# ----------------------------------------------------------
# PAYMENT PROVIDER - future replacement
# ----------------------------------------------------------
PAYMENT_SECRET_KEY=MOCK_REPLACE_ME
PAYMENT_WEBHOOK_SECRET=MOCK_REPLACE_ME

# ----------------------------------------------------------
# AUTH - future replacement
# ----------------------------------------------------------
AUTH_SECRET=MOCK_REPLACE_ME
